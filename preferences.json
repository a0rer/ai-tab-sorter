    "label": "Ollama URL",
    "property": "zen.project.tidy.ollama.url",
    "defaultValue": "http://localhost:11434"
  },
  {
    "type": "string",
    "label": "Ollama model",
    "property": "zen.project.tidy.ollama.model",
    "defaultValue": "llama3.2"
